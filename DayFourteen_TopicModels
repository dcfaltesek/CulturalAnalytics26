#filter some songs
A<-mostswift %>% filter(Taylor.Swift==1) %>% sample_n(25) %>% mutate("Artist"="Taylor")
B<-mostswift %>% filter(Kanye.West==1) %>% sample_n(25)%>% mutate("Artist"="Kanye")
C<-mostswift %>% filter(Chili.Peppers==1) %>% sample_n(25) %>%  mutate("Artist"="RHCP")

songs<-bind_rows(A,B,C)
songs<-songs %>% select(album_name, track_name, song_lyric, Artist) %>% mutate("document"=1:dim(songs[1]))


dtm <- songs |>
  unnest_tokens(word, song_lyric) |>
  anti_join(stop_words, by = "word") |>
  count(document, word) |>
  cast_dtm(document = document, term = word, value = n)

musicLDA<-LDA(dtm, k = 10, control = list(seed = 1234))

perplexity(musicLDA)

terms(musicLDA, k=10)

music_topics <- tidy(musicLDA, matrix = "beta")
View(music_topics)

music_documents <- tidy(musicLDA, matrix = "gamma")
music_documents<-music_documents %>% mutate(document = as.numeric(document))

#and this is the real deep key - NOT IN THE TEXTBOOK
music_wide<-music_documents %>%
  pivot_wider(id_cols=document, 
              names_from = topic,
              values_from = c(gamma))

music_wide

music_information<-inner_join(music_documents, songs)

#make a graph
music_information %>% filter(gamma > .9) %>% ggplot(aes(topic, gamma, colour=Artist))+geom_jitter()

#so lets study those a little more
topic_breakdown<-music_information %>% filter(gamma > .9) %>% group_by(Artist) %>% count(topic)
View(topic_breakdown)

#here it is by artist, you can run it again to get songs
topic_breakdown %>% ggplot(aes(as.factor(topic), n, colour=Artist))+geom_jitter()

